{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InfoHub Workbench",
  "version": "../package.json",
  "identifier": "de.eloyzh.infohub-workbench",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../build"
  },
  "bundle": {
    "active": true,
    "targets": ["app", "appimage", "nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {},
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown",
        "contentTypes": ["net.daringfireball.markdown"]
      }
    ],
    "resources": {
      "gen/infohub-build.json": "infohub-build.json",
      "../LICENSE": "licenses/Otterly-MIT.txt",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../licenses/": "licenses/dependencies/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4REU4OTRDNjM3MTE3NjcKUldSbkYzRmpUSW5lNkhQdzJZWW1SV0hUT0loSXdDYWJ5eTFrVzJibkVVQ3VYZFpuZWdMZmNYL2IK",
      "endpoints": [
        "https://github.com/lpmasser/infohub-workbench/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      },
      "requireSignedVersion": true
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "InfoHub Workbench",
        "width": 1200,
        "height": 820,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: otterly-asset:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  }
}
